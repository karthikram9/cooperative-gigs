# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cooperative_gig1
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-database-passwordyour_postgres_password

# Server Configuration
PORT=8080

# JWT Configuration (at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
$1replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=86400000

# Initial Platform Administrator
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@cooperativegig.com
$1replace-with-a-strong-admin-password
ADMIN_NAME=Platform Admin
ADMIN_PHONE=9000000000

# Welfare Contribution Percentage
WELFARE_CONTRIBUTION_PERCENTAGE=5

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
